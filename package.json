{
  "name": "congress-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "tsx scripts/generate-offline.ts && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --project demo-congress --only database \"tsx --test tests/rules.integration.ts\"",
    "loadtest": "tsx scripts/loadtest.ts",
    "emulators": "tsc -p functions/tsconfig.json && node scripts/emulators.mjs",
    "grant-admin": "tsx functions/src/grant-admin.ts",
    "check:budget": "node scripts/check-budget.mjs",
    "generate:offline": "tsx scripts/generate-offline.ts",
    "test:functions": "tsx tests/functions.integration.ts"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "next": "^16.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "firebase-tools": "^14.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
