rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /questions/{file} {
   allow read: if request.auth != null;
   allow write: if request.auth != null && request.auth.token.admin == true && request.resource.size < 250 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
  }
  match /backups/{path=**} {allow read: if request.auth != null && request.auth.token.admin == true; allow write: if false;}
 }
}
