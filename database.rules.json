{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$code": {
        "public": {
          ".read": "auth != null"
        },
        "players": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "hosts": {
      "$uid": {
        "rooms": {
          ".indexOn": [
            "createdAt"
          ]
        }
      }
    }
  }
}
